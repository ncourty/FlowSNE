\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fields}{{1}{8}{Transport on the flat torus, drift $\omega =\rho (\nabla \phi +w)$ with $\dv (p\,w)=0$, $\rho =0.3$, linear Randers cost, global bandwidth ($n=3000$, $h=0.04$). Arrows are averages over grid cells, all panels on one scale; grey dots are the samples, darker where $p$ is higher. The row-stochastic chain moves along the whole drift. The balanced chain moves along its $p$-solenoidal part only, as predicted by \cref {cor:laplace}}{figure.caption.1}{}}
\newlabel{fig:fields@cref}{{[figure][1][]1}{[1][7][]8}}
\newlabel{fig:leak}{{2}{8}{RMS balanced transport against drift strength on the torus ($n=3000$, $h=0.04$). Left: a gradient drift. With the linear cost and a global bandwidth it stays below $4\times 10^{-11}$ for every $\rho $, outside the plotted range. Right: a solenoidal drift of the same strength, for reference}{figure.caption.3}{}}
\newlabel{fig:leak@cref}{{[figure][2][]2}{[1][7][]8}}
