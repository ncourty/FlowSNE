.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
.pytest_cache/
experiments/**/cache/
experiments/**/data/
experiments/**/*.png
experiments/**/*.pdf
article/figures/*.pdf
# scvelo's dataset loaders cache to ./data/ relative to the CWD a script is
# run from, not relative to the script itself -- catches a stray repo-root
# copy if a script is ever run from the repo root instead of its own dir.
/data/
experiments/**/*.mp4
experiments/**/*.gif
experiments/**/frames.npz
experiments/**/Z_*.npy
experiments/**/flow_*.pt
